{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, Liberation Sans, Helvetica, sans-serif",
    "fontSize": "28px",
    "edgeLabelBackground": "#FFFFFF",
    "lineColor": "#7F8C94"
  },
  "themeCSS": ".edgeLabel, .edgeLabel p, .edgeLabel span { font-size: 24px; color: #374151; } .edgeLabel rect, .labelBkg rect {fill:#FFFFFF; opacity:1;} .labelBkg {background-color:#FFFFFF;}",
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 40,
    "rankSpacing": 50,
    "htmlLabels": true,
    "padding": 12,
    "wrappingWidth": 600
  },
  "markdownAutoWrap": false,
  "layout": "elk",
  "elk": {
    "nodePlacementStrategy": "NETWORK_SIMPLEX",
    "considerModelOrder": "NODES_AND_EDGES"
  }
}